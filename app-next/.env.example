# Postgres — en el VPS es el Postgres NATIVO del servidor (no un contenedor),
# igual que el resto de sitios que corren ahí (ver README.md → Despliegue).
# host 127.0.0.1 en el VPS; localhost/127.0.0.1 también en dev local.
DATABASE_URL="postgresql://musicroaster_app:@127.0.0.1:5432/musicroaster?schema=public"

# MinIO (opcional — en el VPS NO se usa; las fotos van a disco local vía
# lib/storage.ts cuando estas variables no están definidas). Dejar vacío en
# producción salvo que se decida migrar a object storage más adelante.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_BUCKET=musicroster-fotos
MINIO_PUBLIC_URL=

# Correo transaccional (magic link, confirmaciones, avisos de solicitud)
RESEND_API_KEY=
RESEND_FROM="Billboard MusicRoster <no-responder@billboard.com.co>"
# Buzón real del equipo que recibe los avisos internos (p. ej. solicitudes sin
# proyectos). No usar la dirección de RESEND_FROM: no-responder no tiene buzón.
NOTIFICACIONES_ADMIN=contacto@billboard.com.co

# Sesiones (cookies firmadas para comprador y admin) — generar con:
# openssl rand -base64 48
AUTH_SECRET=

# Puerto en el que corre `next start` — OpenLiteSpeed hace proxy a este puerto
# vía el extprocessor del vhost (ver README.md).
PORT=3009

# Dominio público de este despliegue
DOMINIO=musicroaster.billboard.com.co
